{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "pedantic": "warn",
    "perf": "error",
    "restriction": "error",
    "style": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "vitest": true
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "deny"
  },
  "plugins": ["import", "jsdoc", "jsx-a11y", "node", "oxc", "promise", "typescript", "unicorn", "vitest"],
  "rules": {
    "curly": "error",
    "eslint/no-unused-vars": "error",
    "eslint/sort-keys": "error",
    "import/no-cycle": [
      "error",
      {
        "maxDepth": 3
      }
    ]
  }
}
